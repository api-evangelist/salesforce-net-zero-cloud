{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Net Zero Cloud REST Carbon Emissions Emission Factors API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Emission Factors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Emission Factors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.my.salesforce.com/services/data/v59.0/sobjects/EmissionFactor",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Filter by emission factor category"
              },
              {
                "name": "region",
                "value": "",
                "type": "query",
                "description": "Filter by geographic region"
              }
            ]
          },
          "docs": "Retrieves emission factors used to calculate CO2 equivalent emissions from activity data. Includes region-specific grid emission factors, fuel emission factors, and custom factors."
        }
      ]
    }
  ],
  "bundled": true
}